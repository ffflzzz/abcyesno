{
  "name": "abcyesno",
  "version": "1.5.0",
  "description": "Abcyesno - Agent OS based on Hermes harness",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "electron:build": "npm run build && electron-builder --win",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "postinstall": "electron-builder install-app-deps",
    "selfdiag": "node scripts/runtime-diag.mjs",
    "selfdiag:attach": "node scripts/runtime-diag.mjs --attach",
    "check:tdz": "node scripts/check-tdz.js",
    "check:undef": "node scripts/check-undef.js",
    "bridge:build": "node electron/backend/wechat_bridge/build.mjs",
    "shortdrama:venv": "node scripts/setup-shortdrama-venv.mjs",
    "shortdrama:web": "cd shortdrama/frontend && npm ci && npm run build",
    "test:bridge": "node scripts/test-wechat-bridge-unit.mjs",
    "test:browser-panel": "node scripts/test-browser-panel/build.mjs && node scripts/test-browser-panel/run.mjs"
  },
  "build": {
    "appId": "com.hermes.agent",
    "productName": "Abcyesno",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Abcyesno-Setup-${version}.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "hermes-fork/**/*",
      "shortdrama/**/*",
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": "build/playwright-browsers",
        "to": "playwright-browsers"
      },
      {
        "from": "build/runtime/python",
        "to": "runtime/python"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/backend/wechat_bridge/src/tests/**",
      "!electron/backend/wechat_bridge/.tmp-tests/**",
      "hermes-fork/**/*",
      "!hermes-fork/website/**",
      "!hermes-fork/tests/**",
      "!hermes-fork/.pytest_cache/**",
      "!hermes-fork/hermes_agent.egg-info/**",
      "shortdrama/**/*",
      "!shortdrama/projects/**",
      "!shortdrama/**/__pycache__/**",
      "!shortdrama/**/.pytest_cache/**",
      "!shortdrama/.tmp/**",
      "!shortdrama/.langgraph_api/**",
      "!shortdrama/.langgraph_api.bak-*/**",
      "!shortdrama/.env",
      "bin/**/*",
      "package.json",
      "!**/__pycache__/**",
      "!**/*.pyc"
    ],
    "publish": {
      "provider": "github",
      "owner": "ffflzzz",
      "repo": "abcyesno"
    }
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@ag-ui/encoder": "^0.0.57",
    "@copilotkit/react-core": "^1.61.2",
    "@copilotkit/react-ui": "^1.61.2",
    "@copilotkit/shared": "^1.61.2",
    "@xterm/addon-fit": "^0.11.0",
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "edge-tts": "^1.0.1",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "lucide-react": "^1.26.0",
    "qrcode": "^1.5.4",
    "react-markdown": "10.0.0",
    "react-virtuoso": "^4.18.11",
    "remark-gfm": "4.0.1",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.0",
    "playwright-core": "^1.61.1",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
