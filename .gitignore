# --- dependencies / build output ---
node_modules/
dist/
dist-preview/
release/
build/dist/
# paper_rewriter dashboard 的 built 前端要随仓库分发：源码在独立 fork
# (C:/Users/Administrator/Downloads/paper_rewriter_langgraph/frontend)，
# 不在本仓库，build 后拷贝到此。必须纳入版本控制，否则 clone 拿不到新图。
!hermes-fork/skills/langgraph_agents/agents/paper_rewriter_agent/dashboard/frontend/dist/
# Bundled Chromium for portable browser automation (regenerated at build time
# via `playwright install chromium` → copied into build/playwright-browsers).
# Never commit these ~700MB binaries.
build/playwright-browsers/
# Portable Python bundled for venv portability (copied from the managed runtime
# into build/runtime/python by scripts/bundle-python.mjs; ~350MB). The venv's
# pyvenv.cfg is rewritten at runtime to point here, so the app runs on machines
# without the dev machine's Python path. Never commit.
build/runtime/python/

# --- python ---
hermes-fork/.venv/
__pycache__/
*.pyc
*.pyo

# --- runtime data / secrets (contains auth.json etc.) ---
.hermes_dev/
.wb-asar-extract/
*.env
.env*
!.env.example
auth.json

# --- logs / temp ---
*.log
npm-install.log

# --- editor / os ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- workbuddy local memory (keep private) ---
.workbuddy/memory/

# junk: baiduyun upload leftover
*.baiduyun.uploading.cfg

# generated at runtime by scripts/test-multisession/run.mjs
scripts/test-multisession/hook.mjs
scripts/test-multisession/fake-eventbus.mjs

# wechat_bridge 单测的 esbuild 中间产物（scripts/test-wechat-bridge-unit.mjs）
electron/backend/wechat_bridge/.tmp-tests/

# ImageGen 临时输出（scripts/normalize-icons.cjs 的中间产物；最终源在 src/assets/）
gen/

# selfdiag 自检产物（运行时生成；截图+报告）
selfdiag-shots/
selfdiag-report.json
selfdiag-report.md

# bundled ffmpeg binary (large; deployed via copy, not versioned)
bin/

# --- shortdrama 模块（源码入库，运行时产物/依赖不入库）---
# 依赖与虚拟环境：node_modules/ 与 __pycache__/ 已在上面全局忽略，
# shortdrama/.venv 由 `npm run shortdrama:venv` 在本机重建（229MB）。
shortdrama/.venv/
# 每个项目的成片、静帧、中间产物（体积大且与具体项目绑定）
shortdrama/projects/
# langgraph 运行时数据与备份
shortdrama/.langgraph_api/
shortdrama/.langgraph_api.bak-*/
# 临时工作区
shortdrama/.tmp/
# 凭据（与 settings.env 分离，settings.env 只放非密钥项，需入库）
shortdrama/.env
shortdrama/.env.*
!shortdrama/.env.example

# shortdrama 的 SPA 构建产物**必须入库**：shortdrama-runner.js 以
# frontend/dist 作 --web-root，前端源码在独立 checkout 里构建后拷回。
# 同 paper_rewriter dashboard 的处理（见上方 dist/ 段落）。裸 `dist/` 规则
# 会连它一起吞掉，导致打包后短剧页 404。
!shortdrama/frontend/dist/
!shortdrama/frontend/dist/**

# ── 在跑的会话状态与实验产物：只忽略，内容一律不删 ──────────────────
# 2026-09-30 清 git status 时确认这几处是别的会话正在写的，删了就是毁工作现场：
#   .workbuddy/ .qoder/      —— 各工作区的本地会话记忆
#   shortdrama/tmp/          —— 短剧 A/B 臂成片与中间产物（实测 1.4G / 4 万文件，当天仍在写）
# 上方 .workbuddy/memory/ 只盖住了 memory/，tmp/ 会漏出来，这里补整目录。
.workbuddy/
.qoder/
shortdrama/tmp/
# 仓库根 tmp/ 是 scripts/test-browser-panel/build.mjs 的默认输出目录，
# 每次跑都会长出来，别再让它进 status。
/tmp/

# 后台进程条无头截图验收的中间产物（bundle + 截图）
scripts/test-background-process-bar/.tmp/
