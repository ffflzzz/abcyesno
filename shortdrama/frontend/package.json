{
  "name": "shortdrama-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "shortdrama 前端 · React 版（与旧 web/ 并存，互不引用对方的 JS）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node mock/e2e-cdp.mjs",
    "e2e:help": "echo 需先起 vite dev(5173) 与 Chrome 调试实例(9333)；后端不必启动"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
