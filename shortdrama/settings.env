# shortdrama 出厂设置 —— **只放非密钥项**。
#
# 为什么不跟密钥一起放 `.env`：`.env` 按约定只装凭据，且**不进包**（否则等于把
# AGNES key 分发给别人）。但这一批值会**直接改变产物**，不带上就会静默回落到
# `v5/config.py` 的默认值，实测差异如下：
#
#   SHORTDRAMA_STILL_RATIO   默认 3:4(864x1152)  vs 视频 9:16(720x1280)
#                            ⇒ 静帧与成片**画幅不一致**
#   AGNES_VIDEO_MAX_SHOTS    默认 20 ⇒ 超过 20 镜的项目被**截断**
#   SHORTDRAMA_VIDEO_BGM     默认 1  ⇒ 禁忌 BGM 的类型包会被加回背景音乐
#   SHORTDRAMA_VIDEO_MODE    默认已是 reference（2026-10-04 起），写这行是为了
#                            **让出厂档位在文件里可见**，而不是藏在代码默认值里
#
# 由 `electron/backend/shortdrama-runner.js` 在起进程时读入并注入环境变量；
# **真实环境变量优先于本文件**（临时覆盖不必改这里）。

# ── 画幅 ────────────────────────────────────────────────────────────────
# 静帧与视频必须同比例，否则拼接时要么裁边要么留黑边。
SHORTDRAMA_STILL_RATIO=9:16
SHORTDRAMA_ASPECT=9:16

# ── 视频档位（2026-10-04：reference 定为**系统默认档**）──────────────────
# reference = 逐镜各发一条请求、静帧当参考图（各镜独立、可跨 key 并行、能用音频）。
# pack     = 相邻同场景镜打包成一条 ≤12s 的请求（接戏更连贯，但要串行落盘、整轮慢）。
# 两者产物节奏完全不同，**显式写出来**而不是只靠 config.py 的默认值：
# 打包版不带 .env、只读本文件，写死这行 = 出厂行为确定，不必猜代码默认值。
# ⚠️ 临时换档不必改这里 —— 真实环境变量优先于本文件。
SHORTDRAMA_VIDEO_MODE=pack

# ── 视频额度与上限 ──────────────────────────────────────────────────────
# 单项目镜头数上限（超过会被截断并打印警告）。
AGNES_VIDEO_MAX_SHOTS=60
# 单镜秒数上限（供应商硬约束 seconds ∈ [4,12]）。设小于 12 会静默压短超长镜。
AGNES_VIDEO_MAX_SECONDS=12
# 1 = 多条 key 时轮转提交（配合 AGNES_API_KEYS）。
SHORTDRAMA_VIDEO_KEY_ROTATE=1
# 0 = 不加全局 BGM 尾缀（牛来等"禁忌歌唱/背景音乐"的类型包必须关）。
# ⚠️ 这是**全局**开关，对所有类型包生效。
SHORTDRAMA_VIDEO_BGM=0

# ── 厂商档 ──────────────────────────────────────────────────────────────
SHORTDRAMA_CHAT_VENDOR=agnes
SHORTDRAMA_IMAGE_VENDOR=agnes
SHORTDRAMA_VIDEO_VENDOR=agnes

# ── 追踪 ────────────────────────────────────────────────────────────────
LANGSMITH_TRACING=false

# ── 静帧 QC 并发（2026-09-23）────────────────────────────────────────────
# 文本走国内入口（1000rpm）后并发可放开；默认 3 是国际入口时代的保守值。
SHORTDRAMA_QC_WORKERS=8

# 同场多机位默认启用，可设 0 回退旧创作口径。
SHORTDRAMA_SHOT_COVERAGE=1
